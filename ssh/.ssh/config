# Local-only hosts
Include ~/.ssh/config.local

# SSH keepalive
Host *
  ServerAliveInterval 30
  ServerAliveCountMax 3
  TCPKeepAlive yes

# GitHub accounts
Host github-work
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_work
  IdentitiesOnly yes
  AddKeysToAgent yes

Host github-personal
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_ed25519_personal
  IdentitiesOnly yes
  AddKeysToAgent yes

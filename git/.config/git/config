[init]
    defaultBranch = main

[pull]
	rebase = true

[push]
    autoSetupRemote = true

[fetch]
    prune = true

[commit]
	gpgsign = false

[includeIf "gitdir:~/work/"]
    path = ~/.config/git/work.identity

[includeIf "gitdir:~/personal/"]
    path = ~/.config/git/personal.identity
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
